# Salin ke .env di server (tidak di-commit ke Git).
# cPanel: /home/USERNAME/apps/erp_cnvs/.env
#
# MySQL cPanel — encode karakter khusus di password:
#   ! → %21   @ → %40   # → %23
# Contoh password !Canvas123 → %21Canvas123
#
# DATABASE_URL="mysql://user:%21Password@localhost:3306/username_erp_cnvs"
DATABASE_URL="mysql://root:@localhost:3306/erp_cnvs"
#
# Wajib untuk login (minimal 16 karakter)
AUTH_SECRET="ganti-dengan-string-acak-minimal-16-karakter"
#
# Production (cPanel Node.js App juga set env ini)
NODE_ENV=production
#
# Subdomain production (untuk Server Actions di cPanel), pisahkan dengan koma jika perlu
# ALLOWED_ORIGINS=erpcanvas.senadara.my.id
#
# Seed: akun owner pertama (opsional)
SEED_OWNER_EMAIL="owner@karsa.local"
SEED_OWNER_PASSWORD="Owner123!"
