# Salin ke .env: Copy-Item .env.example .env
#
# MySQL — buat DB: CREATE DATABASE erp_cnvs CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:@localhost:3306/erp_cnvs"
#
# Wajib untuk login (minimal 16 karakter). Contoh: openssl rand -hex 16
AUTH_SECRET="ganti-dengan-string-acak-minimal-16-karakter"
#
# Seed: akun owner pertama (opsional, ada default di seed.ts)
SEED_OWNER_EMAIL="owner@karsa.local"
SEED_OWNER_PASSWORD="Owner123!"
